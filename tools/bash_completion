# This script autocompletes "rapido" subcommands and "rapido cut" image
# generators.
# Source it in your bashrc:
#   . <rapido_dir>/tools/bash_completion
#
# or create a bash_completion.d link:
#   ln -s <rapido_dir>/tools/bash_completion /etc/bash_completion.d/rapido

__rapido_complete() {
	local p="$(realpath -e ${BASH_SOURCE[0]%/*})/../target/release/:${PATH}"
	local bin="$(PATH="$p" type -P bash-completion)"
	if [[ -x $bin ]]; then
		complete -C "$bin" rapido
		complete -C "$bin" ./rapido
	else
		echo "Build needed? No bash-completion binary in PATH=$p" >&2
	fi
}

__rapido_complete
